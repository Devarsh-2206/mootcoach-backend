rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own analyses, memorials and sessions. Nobody else's.
    match /artifacts/moot.coach/users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // The Moot Calendar's shared competition list.
    //
    // Readable by every signed-in user: the whole point is that one entry
    // reaches everyone. Not world-readable, because the calendar is only
    // reachable from the workspace, which already requires a login.
    //
    // No client writes at all. Competitions are seeded with the Admin SDK
    // (tools/seed-competitions.js), which bypasses these rules, so leaving
    // write closed costs nothing and stops any signed-in user from editing
    // the deadlines everybody else is planning around.
    match /artifacts/moot.coach/competitions/{competitionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
